# Continuous WAL archive for point-in-time recovery (see pg-receivewal.sh).
[Unit]
Description=CliRelay WAL archive (pg_receivewal)
After=docker.service network-online.target
Requires=docker.service

[Service]
EnvironmentFile=/etc/clirelay-cluster/backup.env
ExecStart=/opt/clirelay-cluster/backup/pg-receivewal.sh
ExecStop=/usr/bin/docker stop -t 20 clirelay-walarchive
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
