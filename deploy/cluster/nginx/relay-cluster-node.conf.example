# CliRelay behind nginx on one cluster node (example for node n43 with peer
# n2; swap the addresses and names on the other node).
#
# Traffic reaches 127.0.0.1:8444 through the stream SNI router on :443. The
# local CliRelay slot serves it first. The peer node takes a request only
# when the local slot refuses the connection (down, restarting, being
# deployed) or already holds max_conns connections.
#
# On cutover the deploy script rewrites every reference to the active slot
# port (8318 or 8319) in this file: the upstream server and the 8445
# proxy_pass below. It refuses to deploy if they disagree, so keep both slot
# references in this one file.

upstream clirelay_app {
    zone clirelay_app 64k;
    server 127.0.0.1:8319 max_conns=400;
    # Spill-over: a local hop that forwards to the peer node over mutual TLS.
    server 127.0.0.1:8446 backup;
}

server {
    listen 43.255.122.4:80;
    server_name code.07230805.xyz relay.07230805.xyz;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 127.0.0.1:8444 ssl http2;
    server_name code.07230805.xyz relay.07230805.xyz;
    client_max_body_size 2000m;
    ssl_certificate /etc/letsencrypt/live/code.07230805.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/code.07230805.xyz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # The management panel is static and every node serves its own copy.
    location = /management.html { root /var/www/html/relay-panel; try_files /management.html =404; add_header Cache-Control no-cache; }
    # The panel deploy workflow reads the release it just published here, per node.
    location = /manage/version.txt { alias /var/www/html/relay-panel/version.txt; default_type text/plain; add_header Cache-Control no-cache; }
    location = /manage.html { root /var/www/html/relay-panel; try_files /manage.html =404; add_header Cache-Control no-cache; }
    location ^~ /manage/assets/ { alias /var/www/html/relay-panel/assets/; expires 1y; add_header Cache-Control "public, immutable"; access_log off; }
    location = /manage { return 301 /manage/dashboard; }
    location ^~ /manage/ { root /var/www/html/relay-panel; try_files $uri $uri/ @manage_fallback; add_header Cache-Control no-cache; }
    location @manage_fallback { root /var/www/html/relay-panel; rewrite ^ /manage.html break; add_header Cache-Control no-cache; }
    location /assets/ { root /var/www/html/relay-panel; expires 1y; add_header Cache-Control "public, immutable"; access_log off; }

    location / {
        proxy_pass http://clirelay_app;
        # Only connection-level failures move a request to the peer: the
        # request has not been sent yet, so this is safe for POST too.
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 3s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
        client_max_body_size 1000m;
    }
}

# Spill-over hop: forwards to the peer node's 8445 with this node's cluster
# certificate. The client addresses the first hop recorded pass through as-is.
server {
    listen 127.0.0.1:8446;
    client_max_body_size 2000m;
    location / {
        proxy_pass https://198.51.100.20:8445;
        proxy_ssl_certificate /etc/clirelay-cluster/tls/node.crt;
        proxy_ssl_certificate_key /etc/clirelay-cluster/tls/node.key;
        proxy_ssl_trusted_certificate /etc/clirelay-cluster/tls/ca.crt;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 2;
        proxy_ssl_name n2;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_ssl_session_reuse on;
        proxy_connect_timeout 5s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-CliRelay-Spill-From n43;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
        client_max_body_size 1000m;
    }
}

# Accepts the peer's spill-over: mutual TLS against the cluster CA, and only
# the local slot behind it, so a request can never bounce between nodes.
server {
    listen 43.255.122.4:8445 ssl;
    server_name n43;
    ssl_certificate /etc/clirelay-cluster/tls/node.crt;
    ssl_certificate_key /etc/clirelay-cluster/tls/node.key;
    ssl_client_certificate /etc/clirelay-cluster/tls/ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2000m;
    location / {
        proxy_pass http://127.0.0.1:8319;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
        client_max_body_size 1000m;
    }
}
